# Cloudflare Pages redirects — https://developers.cloudflare.com/pages/configuration/redirects/
# Note: fragment targets (/#services) are not reliable here — plain targets only.

# Old site structure → new (no blog, no separate work page)
/blog/*        /    301
/blog          /    301
/work/*        /    301
/work          /    301
/services.html /    301
/about.html    /    301

# Extension niceties
index.html     /    302
contact.html   /contact    301

# security.txt canonical location
/security.txt  /.well-known/security.txt 302